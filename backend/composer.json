{
  "name": "leowebguy/fantasticdevs",
  "description": "Craft CMS, NEO, GraphQL, Nuxt, Nitro, Vue, Vite",
  "author": {
    "name": "Leo Leoncio",
    "email": "leowebguy@gmail.com",
    "homepage": "https://github.com/leowebguy/"
  },
  "license": "proprietary",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/aws-s3": "^2.2.3",
    "craftcms/ckeditor": "^4.9",
    "craftcms/cms": "^5.8",
    "nystudio107/craft-code-field": "^5.0.1",
    "spicyweb/craft-neo": "^5.5.2",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\base\\": "modules/base/src/",
      "backend\\": "."
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@php craft migrate/all --interactive=0",
      "@php craft project-config/apply"
    ],
    "post-install-cmd": [
      "@php craft migrate/all --interactive=0",
      "@php craft project-config/apply"
    ]
  }
}
